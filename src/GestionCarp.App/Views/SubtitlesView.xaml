<UserControl x:Class="GestionCarp.App.Views.SubtitlesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GestionCarp.App.Localization"
             xmlns:vm="clr-namespace:GestionCarp.App.ViewModels"
             xmlns:core="clr-namespace:GestionCarp.Core.Rename;assembly=GestionCarp.Core"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,0,0,8"
                   Text="{l:Tr sub_intro}"/>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{l:Tr lbl_folder}" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                <Button Content="{l:Tr btn_browse}" Command="{Binding BrowseCommand}"/>
                <Button Content="{l:Tr btn_scan}" Command="{Binding AnalyzeCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/>
            </StackPanel>
            <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{l:Tr sub_match}" Style="{StaticResource FieldLabel}"/>
            <ComboBox Width="330" Margin="0,0,16,4" ItemsSource="{x:Static vm:Choices.SubtitleModes}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectedValue="{Binding Mode}"/>
            <CheckBox Content="{l:Tr lbl_subfolders}" IsChecked="{Binding IncludeSubfolders}" Margin="0,0,14,4"/>
            <CheckBox Content="{l:Tr sub_keep_lang}" IsChecked="{Binding KeepLanguageTags}" Margin="0,0,14,4"/>
            <TextBlock Text="{l:Tr sub_default_lang}" Style="{StaticResource FieldLabel}"/>
            <TextBox Width="50" Margin="0,0,14,4" Text="{Binding DefaultLanguage, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{l:Tr sub_default_lang_tip}"/>
            <CheckBox Content="{l:Tr sub_move}" IsChecked="{Binding MoveToVideoFolder}" Margin="0,0,14,4"/>
        </WrapPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:Tr sub_select_all}" Command="{Binding SelectAllCommand}"/>
                <Button Content="{l:Tr sub_select_none}" Command="{Binding SelectNoneCommand}"/>
                <Button Content="{l:Tr btn_undo}" Command="{Binding UndoCommand}" ToolTip="{Binding UndoDescription}"/>
                <Button Content="{l:Tr sub_apply}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/>
            </StackPanel>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </DockPanel>

        <Grid>
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                      Background="White" SelectionMode="Extended">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding Message}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Ready}">
                                <Setter Property="Background" Value="{StaticResource ReadyRowBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Warning}">
                                <Setter Property="Background" Value="{StaticResource WarningRowBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Error}">
                                <Setter Property="Background" Value="{StaticResource ErrorRowBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Skipped}">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="30">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" Margin="0"
                                          ToolTip="{l:Tr sub_include_tip}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="" Binding="{Binding StatusIcon}" Width="26"/>
                    <DataGridTextColumn Header="{l:Tr col_sub_current}" Binding="{Binding CurrentName}" Width="*"/>
                    <DataGridTextColumn Header="{l:Tr col_video}" Binding="{Binding VideoName}" Width="*"/>
                    <DataGridTextColumn Header="{l:Tr col_new}" Binding="{Binding NewName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{l:Tr col_notes}" Binding="{Binding Message}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{l:Tr sub_empty_hint}"
                       Style="{StaticResource Hint}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibility}}"/>
        </Grid>
    </DockPanel>
</UserControl>
