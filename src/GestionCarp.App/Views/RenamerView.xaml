<UserControl x:Class="GestionCarp.App.Views.RenamerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GestionCarp.App.Localization"
             xmlns:vm="clr-namespace:GestionCarp.App.ViewModels"
             xmlns:rules="clr-namespace:GestionCarp.Core.Rename.Rules;assembly=GestionCarp.Core"
             xmlns:core="clr-namespace:GestionCarp.Core.Rename;assembly=GestionCarp.Core">
    <UserControl.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
        </Style>
        <Style x:Key="FormField" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>

        <!-- Selector común: a qué parte del nombre se aplica la regla -->
        <DataTemplate x:Key="ScopeEditor">
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Tr ren_apply_to}" Style="{StaticResource FormLabel}"/>
                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:Choices.RuleScopes}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding Scope}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:NumberingRule}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{l:Tr num_position}" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" ItemsSource="{x:Static vm:Choices.NumberPlacements}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Placement}"/>
                    <TextBlock Grid.Row="1" Text="{l:Tr num_before}" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding TextBefore, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{l:Tr num_before_tip}"/>
                    <TextBlock Grid.Row="2" Text="{l:Tr num_after}" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding TextAfter, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Text="{l:Tr num_start}" Style="{StaticResource FormLabel}"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                        <TextBox Width="50" Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{l:Tr num_step}" Style="{StaticResource FormLabel}" Margin="12,0,6,0"/>
                        <TextBox Width="40" Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="{l:Tr num_digits}" Style="{StaticResource FormLabel}"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                        <TextBox Width="40" Text="{Binding Digits, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{l:Tr num_digits_tip}"/>
                        <TextBlock Text="{l:Tr num_digits_hint}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,6,0,3" Content="{l:Tr num_restart}"
                              IsChecked="{Binding RestartPerFolder}"
                              ToolTip="{l:Tr num_restart_tip}"/>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ScopeEditor}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="{l:Tr num_example}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:ReplaceRule}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:Tr rep_find}" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Margin="0,3" Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="{l:Tr rep_with}" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding ReplaceWith, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <WrapPanel Margin="110,4,0,0">
                    <CheckBox Content="{l:Tr rep_all}" IsChecked="{Binding ReplaceAll}" Margin="0,3,14,3"/>
                    <CheckBox Content="{l:Tr rep_case}" IsChecked="{Binding CaseSensitive}" Margin="0,3,14,3"/>
                    <CheckBox Content="{l:Tr rep_regex}" IsChecked="{Binding UseRegex}" Margin="0,3,14,3"
                              ToolTip="{l:Tr rep_regex_tip}"/>
                </WrapPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ScopeEditor}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="{l:Tr rep_example}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:InsertRule}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:Tr ins_text}" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Margin="0,3" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="{l:Tr ins_where}" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" ItemsSource="{x:Static vm:Choices.InsertPositions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Position}"/>
                    <TextBlock Grid.Row="2" Text="{l:Tr ins_after_char}" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Width="50" HorizontalAlignment="Left"
                             Text="{Binding Index, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{l:Tr ins_after_char_tip}"/>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ScopeEditor}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:RemoveRule}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:Tr rem_remove}" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Column="1" Margin="0,3" ItemsSource="{x:Static vm:Choices.RemoveModes}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode}"/>
                    <TextBlock Grid.Row="1" Text="{l:Tr rem_count}" Style="{StaticResource FormLabel}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                        <TextBox Width="50" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{l:Tr rem_from}" Style="{StaticResource FormLabel}" Margin="12,0,6,0"/>
                        <TextBox Width="50" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{l:Tr rem_from_tip}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{l:Tr rem_delims}" Style="{StaticResource FormLabel}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                        <TextBox Width="40" Text="{Binding OpenDelimiter, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="…" Margin="6,0" VerticalAlignment="Center"/>
                        <TextBox Width="40" Text="{Binding CloseDelimiter, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{l:Tr rem_delims_hint}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,3" Content="{l:Tr rem_clean}" IsChecked="{Binding CleanSpaces}"/>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ScopeEditor}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="{l:Tr rem_example}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:SeriesTemplateRule}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:Tr series_template}" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Column="1" Margin="0,3" IsEditable="True"
                              ItemsSource="{x:Static vm:RenamerViewModel.SeriesTemplateExamples}"
                              Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="{l:Tr series_template_tip}"/>
                    <TextBlock Grid.Row="1" Text="{l:Tr series_name}" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding SeriesName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{l:Tr series_name_tip}"/>
                    <TextBlock Grid.Row="2" Text="{l:Tr series_default_season}" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Width="50" HorizontalAlignment="Left"
                             Text="{Binding DefaultSeason, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{l:Tr series_default_season_tip}"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{l:Tr series_help}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:CleanupRule}">
            <StackPanel>
                <CheckBox Content="{l:Tr clean_separators}" IsChecked="{Binding ReplaceSeparators}" Margin="0,3"/>
                <CheckBox Content="{l:Tr clean_brackets}" IsChecked="{Binding RemoveBrackets}" Margin="0,3"/>
                <CheckBox Content="{l:Tr clean_parens}" IsChecked="{Binding RemoveParentheses}" Margin="0,3"/>
                <CheckBox Content="{l:Tr clean_tags}" IsChecked="{Binding RemoveReleaseTags}" Margin="0,3"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ScopeEditor}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{l:Tr clean_example}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:CaseRule}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Tr case_convert}" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Column="1" Margin="0,3" ItemsSource="{x:Static vm:Choices.CaseModes}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode}"/>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ScopeEditor}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="300"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
        </Grid.ColumnDefinitions>

        <!-- Reglas -->
        <DockPanel Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="{l:Tr preset_label}" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                <Menu DockPanel.Dock="Right" Background="Transparent" VerticalAlignment="Center" Margin="6,0,0,0">
                    <MenuItem Header="⋯" Padding="8,4" BorderBrush="#BBB" BorderThickness="1" ToolTip="{l:Tr preset_more}">
                        <MenuItem Header="{l:Tr preset_save}" Command="{Binding SavePresetCommand}"/>
                        <MenuItem Header="{l:Tr preset_delete}" Command="{Binding DeletePresetCommand}"/>
                        <Separator/>
                        <MenuItem Header="{l:Tr preset_export}" Command="{Binding ExportPresetCommand}"/>
                        <MenuItem Header="{l:Tr preset_import}" Command="{Binding ImportPresetCommand}"/>
                    </MenuItem>
                </Menu>
                <Button DockPanel.Dock="Right" Content="{l:Tr preset_load}" Command="{Binding LoadPresetCommand}" Margin="6,0,0,0"
                        ToolTip="{l:Tr preset_load_tip}"/>
                <ComboBox ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPreset}"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{l:Tr ren_rules}" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock DockPanel.Dock="Top" Text="{l:Tr ren_rules_hint}"
                       Style="{StaticResource Hint}" Margin="0,2,0,6"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <Menu Background="Transparent" Margin="0,0,6,0" VerticalAlignment="Center">
                    <MenuItem Header="{l:Tr ren_add_rule}" Padding="10,5" BorderBrush="#BBB" BorderThickness="1">
                        <MenuItem Header="{l:Tr ren_add_num}" Command="{Binding AddRuleCommand}" CommandParameter="Numerar"/>
                        <MenuItem Header="{l:Tr ren_add_series}" Command="{Binding AddRuleCommand}" CommandParameter="Serie"/>
                        <MenuItem Header="{l:Tr ren_add_clean}" Command="{Binding AddRuleCommand}" CommandParameter="Limpiar"/>
                        <Separator/>
                        <MenuItem Header="{l:Tr ren_add_replace}" Command="{Binding AddRuleCommand}" CommandParameter="Reemplazar"/>
                        <MenuItem Header="{l:Tr ren_add_insert}" Command="{Binding AddRuleCommand}" CommandParameter="Insertar"/>
                        <MenuItem Header="{l:Tr ren_add_remove}" Command="{Binding AddRuleCommand}" CommandParameter="Eliminar"/>
                        <MenuItem Header="{l:Tr ren_add_case}" Command="{Binding AddRuleCommand}" CommandParameter="Mayusculas"/>
                    </MenuItem>
                </Menu>
                <Button Content="✖" ToolTip="{l:Tr ren_rule_remove_tip}" Command="{Binding RemoveRuleCommand}"/>
                <Button Content="▲" ToolTip="{l:Tr tip_up}" Command="{Binding MoveRuleUpCommand}"/>
                <Button Content="▼" ToolTip="{l:Tr tip_down}" Command="{Binding MoveRuleDownCommand}"/>
            </StackPanel>

            <Grid DockPanel.Dock="Top" Height="190" Margin="0,0,0,8">
                <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,3">
                                <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Top" Margin="0,2,6,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{l:Tr ren_no_rules}"
                           Style="{StaticResource Hint}" TextAlignment="Center" FontSize="12.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding HasRules, Converter={StaticResource InverseBoolToVisibility}}"/>
            </Grid>

            <GroupBox Header="{l:Tr ren_rule_config}"
                      Visibility="{Binding HasSelectedRule, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding SelectedRule}"/>
                </ScrollViewer>
            </GroupBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- Archivos -->
        <DockPanel Grid.Column="2">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button Content="{l:Tr ren_add_files}" Command="{Binding AddFilesCommand}" Margin="0,0,6,4"/>
                <Button Content="{l:Tr ren_add_folder}" Command="{Binding AddFolderCommand}" Margin="0,0,6,4"/>
                <Button Content="{l:Tr ren_remove}" Command="{Binding RemoveSelectedCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}" Margin="0,0,6,4"
                        ToolTip="{l:Tr ren_remove_tip}"/>
                <Button Content="{l:Tr ren_clear}" Command="{Binding ClearCommand}" Margin="0,0,6,4"/>
                <Button Content="{l:Tr ren_sort}" Command="{Binding SortCommand}" Margin="0,0,6,4"
                        ToolTip="{l:Tr ren_sort_tip}"/>
                <Button Content="▲" Command="{Binding MoveItemsUpCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}" Margin="0,0,6,4" ToolTip="{l:Tr ren_up_tip}"/>
                <Button Content="▼" Command="{Binding MoveItemsDownCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}" Margin="0,0,6,4" ToolTip="{l:Tr ren_down_tip}"/>
            </WrapPanel>

            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="{l:Tr ren_when_adding}" Style="{StaticResource FieldLabel}"/>
                <CheckBox Content="{l:Tr lbl_subfolders}" IsChecked="{Binding IncludeSubfolders}"/>
                <CheckBox Content="{l:Tr ren_folders_too}" IsChecked="{Binding IncludeFolders}"
                          ToolTip="{l:Tr ren_folders_too_tip}"/>
                <TextBlock Text="{l:Tr ren_filter}" Style="{StaticResource FieldLabel}"/>
                <TextBox Width="140" Text="{Binding AddFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{l:Tr ren_filter_tip}"/>
            </WrapPanel>

            <CheckBox DockPanel.Dock="Top" Margin="0,2,0,8" IsChecked="{Binding RenameSubtitlesWithVideo}"
                      FontWeight="SemiBold">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{l:Tr ren_subs_with_video}"/>
                        <Run Text="{l:Tr ren_subs_example}" FontWeight="Normal" Foreground="{StaticResource MutedBrush}"/>
                    </TextBlock>
                </CheckBox.Content>
                <CheckBox.ToolTip>
                    <TextBlock Text="{l:Tr ren_subs_tip}" TextWrapping="Wrap" MaxWidth="420"/>
                </CheckBox.ToolTip>
            </CheckBox>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{l:Tr btn_undo}" Command="{Binding UndoCommand}" ToolTip="{Binding UndoDescription}"/>
                    <Button Content="{l:Tr ren_rename}" Command="{Binding RenameCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </DockPanel>

            <Grid>
                <DataGrid x:Name="FilesGrid" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                          SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" Background="White"
                          AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" PreviewKeyDown="OnGridKeyDown"
                          EnableRowVirtualization="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding Message}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Ready}">
                                    <Setter Property="Background" Value="{StaticResource ReadyRowBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Warning}">
                                    <Setter Property="Background" Value="{StaticResource WarningRowBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Error}">
                                    <Setter Property="Background" Value="{StaticResource ErrorRowBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Binding="{Binding StatusIcon}" Width="28"/>
                        <DataGridTemplateColumn Header="{l:Tr col_current}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,1">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding OriginalName}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:Tr col_new}" Binding="{Binding NewName}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="2,1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{l:Tr col_subs}" Binding="{Binding CompanionsText}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="4,1"/>
                                    <Setter Property="ToolTip" Value="{Binding CompanionsTooltip}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{l:Tr col_notes}" Binding="{Binding Message}" Width="180"/>
                        <DataGridTextColumn Header="{l:Tr col_folder}" Binding="{Binding Folder}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{l:Tr ren_empty_hint}"
                           Style="{StaticResource Hint}" FontSize="14" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}"/>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
