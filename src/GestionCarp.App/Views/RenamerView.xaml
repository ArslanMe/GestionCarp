<UserControl x:Class="GestionCarp.App.Views.RenamerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GestionCarp.App.ViewModels"
             xmlns:rules="clr-namespace:GestionCarp.Core.Rename.Rules;assembly=GestionCarp.Core"
             xmlns:core="clr-namespace:GestionCarp.Core.Rename;assembly=GestionCarp.Core">
    <UserControl.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
        </Style>
        <Style x:Key="FormField" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>

        <!-- Selector común: a qué parte del nombre se aplica la regla -->
        <DataTemplate x:Key="ScopeEditor">
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Aplicar a:" Style="{StaticResource FormLabel}"/>
                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:Choices.RuleScopes}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding Scope}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:NumberingRule}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Posición:" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" ItemsSource="{x:Static vm:Choices.NumberPlacements}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Placement}"/>
                    <TextBlock Grid.Row="1" Text="Texto antes:" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding TextBefore, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Por ejemplo «Mi Serie - Cap» o «Mi Serie - »"/>
                    <TextBlock Grid.Row="2" Text="Texto después:" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding TextAfter, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Text="Empezar en:" Style="{StaticResource FormLabel}"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                        <TextBox Width="50" Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Incremento:" Style="{StaticResource FormLabel}" Margin="12,0,6,0"/>
                        <TextBox Width="40" Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="Cifras:" Style="{StaticResource FormLabel}"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                        <TextBox Width="40" Text="{Binding Digits, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="2 → 01, 02…   3 → 001, 002…"/>
                        <TextBlock Text="(rellena con ceros)" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,6,0,3" Content="Reiniciar la numeración en cada carpeta"
                              IsChecked="{Binding RestartPerFolder}"
                              ToolTip="Útil con varias temporadas: cada carpeta empieza otra vez en el primer número"/>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ScopeEditor}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="Ejemplo: «Mi Serie - Cap» con 2 cifras → Mi Serie - Cap01, Mi Serie - Cap02… El orden es el de la lista de la derecha."/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:ReplaceRule}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Buscar:" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Margin="0,3" Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="Reemplazar por:" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding ReplaceWith, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <WrapPanel Margin="110,4,0,0">
                    <CheckBox Content="Todas las veces" IsChecked="{Binding ReplaceAll}" Margin="0,3,14,3"/>
                    <CheckBox Content="Distinguir mayúsculas" IsChecked="{Binding CaseSensitive}" Margin="0,3,14,3"/>
                    <CheckBox Content="Expresión regular" IsChecked="{Binding UseRegex}" Margin="0,3,14,3"
                              ToolTip="Para usuarios avanzados. En «Reemplazar por» puedes usar $1, $2… para los grupos"/>
                </WrapPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ScopeEditor}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="Ejemplo: buscar «.» y reemplazar por « » convierte Mi.Serie.01 en Mi Serie 01."/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:InsertRule}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Texto:" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Margin="0,3" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="Dónde:" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" ItemsSource="{x:Static vm:Choices.InsertPositions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Position}"/>
                    <TextBlock Grid.Row="2" Text="Tras carácter nº:" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Width="50" HorizontalAlignment="Left"
                             Text="{Binding Index, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Solo con «En una posición». 0 = al principio"/>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ScopeEditor}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:RemoveRule}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Eliminar:" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Column="1" Margin="0,3" ItemsSource="{x:Static vm:Choices.RemoveModes}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode}"/>
                    <TextBlock Grid.Row="1" Text="Cantidad:" Style="{StaticResource FormLabel}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                        <TextBox Width="50" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Desde posición:" Style="{StaticResource FormLabel}" Margin="12,0,6,0"/>
                        <TextBox Width="50" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Solo en modo tramo. 1 = primer carácter"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="Delimitadores:" Style="{StaticResource FormLabel}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                        <TextBox Width="40" Text="{Binding OpenDelimiter, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="…" Margin="6,0" VerticalAlignment="Center"/>
                        <TextBox Width="40" Text="{Binding CloseDelimiter, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="ej. [ ] o ( )" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,3" Content="Limpiar espacios sobrantes" IsChecked="{Binding CleanSpaces}"/>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ScopeEditor}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="Ejemplo: con delimitadores [ y ], «[Grupo] Serie 01 [1080p]» queda «Serie 01»."/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:CaseRule}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Convertir a:" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Column="1" Margin="0,3" ItemsSource="{x:Static vm:Choices.CaseModes}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode}"/>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ScopeEditor}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="300"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
        </Grid.ColumnDefinitions>

        <!-- Reglas -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Reglas" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock DockPanel.Dock="Top" Text="Se aplican en orden, de arriba abajo. Desmarca una para desactivarla."
                       Style="{StaticResource Hint}" Margin="0,2,0,6"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <Menu Background="Transparent" Margin="0,0,6,0" VerticalAlignment="Center">
                    <MenuItem Header="➕ Añadir regla ▾" Padding="10,5" BorderBrush="#BBB" BorderThickness="1">
                        <MenuItem Header="Numerar (Cap01, Cap02…)" Command="{Binding AddRuleCommand}" CommandParameter="Numerar"/>
                        <MenuItem Header="Reemplazar texto" Command="{Binding AddRuleCommand}" CommandParameter="Reemplazar"/>
                        <MenuItem Header="Insertar texto" Command="{Binding AddRuleCommand}" CommandParameter="Insertar"/>
                        <MenuItem Header="Eliminar caracteres" Command="{Binding AddRuleCommand}" CommandParameter="Eliminar"/>
                        <MenuItem Header="Mayúsculas / minúsculas" Command="{Binding AddRuleCommand}" CommandParameter="Mayusculas"/>
                    </MenuItem>
                </Menu>
                <Button Content="✖" ToolTip="Quitar la regla" Command="{Binding RemoveRuleCommand}"/>
                <Button Content="▲" ToolTip="Subir" Command="{Binding MoveRuleUpCommand}"/>
                <Button Content="▼" ToolTip="Bajar" Command="{Binding MoveRuleDownCommand}"/>
            </StackPanel>

            <Grid DockPanel.Dock="Top" Height="190" Margin="0,0,0,8">
                <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,3">
                                <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Top" Margin="0,2,6,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Sin reglas. Pulsa «Añadir regla».&#x0a;Para una serie, empieza por «Numerar»."
                           Style="{StaticResource Hint}" TextAlignment="Center" FontSize="12.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding HasRules, Converter={StaticResource InverseBoolToVisibility}}"/>
            </Grid>

            <GroupBox Header="Configuración de la regla seleccionada"
                      Visibility="{Binding HasSelectedRule, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding SelectedRule}"/>
                </ScrollViewer>
            </GroupBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- Archivos -->
        <DockPanel Grid.Column="2">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button Content="Añadir archivos…" Command="{Binding AddFilesCommand}" Margin="0,0,6,4"/>
                <Button Content="Añadir carpeta…" Command="{Binding AddFolderCommand}" Margin="0,0,6,4"/>
                <Button Content="Quitar" Command="{Binding RemoveSelectedCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}" Margin="0,0,6,4"
                        ToolTip="Quita de la lista los seleccionados (no borra archivos). Tecla Supr"/>
                <Button Content="Vaciar lista" Command="{Binding ClearCommand}" Margin="0,0,6,4"/>
                <Button Content="Ordenar A→Z" Command="{Binding SortCommand}" Margin="0,0,6,4"
                        ToolTip="Orden natural: Cap2 va antes que Cap10"/>
                <Button Content="▲" Command="{Binding MoveItemsUpCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}" Margin="0,0,6,4" ToolTip="Subir seleccionados"/>
                <Button Content="▼" Command="{Binding MoveItemsDownCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}" Margin="0,0,6,4" ToolTip="Bajar seleccionados"/>
            </WrapPanel>

            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="Al añadir carpetas:" Style="{StaticResource FieldLabel}"/>
                <CheckBox Content="Incluir subcarpetas" IsChecked="{Binding IncludeSubfolders}"/>
                <CheckBox Content="Añadir también las carpetas" IsChecked="{Binding IncludeFolders}"
                          ToolTip="Para renombrar las propias carpetas (por ejemplo, las temporadas)"/>
                <TextBlock Text="Filtro:" Style="{StaticResource FieldLabel}"/>
                <TextBox Width="140" Text="{Binding AddFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Ejemplo: *.mkv; *.mp4. Vacío = todos los archivos"/>
            </WrapPanel>

            <CheckBox DockPanel.Dock="Top" Margin="0,2,0,8" IsChecked="{Binding RenameSubtitlesWithVideo}"
                      FontWeight="SemiBold">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        💬 Renombrar también los subtítulos de cada vídeo
                        <Run Text="(Serie.e1.mkv + Serie.e1.es.srt → Cap01.mkv + Cap01.es.srt)" FontWeight="Normal" Foreground="{StaticResource MutedBrush}"/>
                    </TextBlock>
                </CheckBox.Content>
                <CheckBox.ToolTip>
                    Los subtítulos de la misma carpeta que se llaman igual que el vídeo (con o sin idioma: .es, .en, .forced…)
                    reciben el nuevo nombre del vídeo, aunque no estén en la lista. Así el reproductor los sigue encontrando.
                </CheckBox.ToolTip>
            </CheckBox>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="↶ Deshacer" Command="{Binding UndoCommand}" ToolTip="{Binding UndoDescription}"/>
                    <Button Content="Renombrar" Command="{Binding RenameCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </DockPanel>

            <Grid>
                <DataGrid x:Name="FilesGrid" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                          SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" Background="White"
                          AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" PreviewKeyDown="OnGridKeyDown"
                          EnableRowVirtualization="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding Message}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Ready}">
                                    <Setter Property="Background" Value="{StaticResource ReadyRowBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Warning}">
                                    <Setter Property="Background" Value="{StaticResource WarningRowBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Error}">
                                    <Setter Property="Background" Value="{StaticResource ErrorRowBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Binding="{Binding StatusIcon}" Width="28"/>
                        <DataGridTemplateColumn Header="Nombre actual" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,1">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding OriginalName}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Nombre nuevo" Binding="{Binding NewName}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="2,1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Subtítulos" Binding="{Binding CompanionsText}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="4,1"/>
                                    <Setter Property="ToolTip" Value="{Binding CompanionsTooltip}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Observaciones" Binding="{Binding Message}" Width="180"/>
                        <DataGridTextColumn Header="Carpeta" Binding="{Binding Folder}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Arrastra aquí archivos o carpetas&#x0a;o usa «Añadir archivos…» / «Añadir carpeta…»"
                           Style="{StaticResource Hint}" FontSize="14" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}"/>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
