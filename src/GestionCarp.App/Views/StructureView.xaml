<UserControl x:Class="GestionCarp.App.Views.StructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GestionCarp.App.Localization"
             xmlns:st="clr-namespace:GestionCarp.Core.Structure;assembly=GestionCarp.Core">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="{l:Tr struct_intro}" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,0,0,8"/>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{l:Tr struct_destination}" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                <Button Content="{l:Tr btn_browse}" Command="{Binding BrowseCommand}"/>
                <CheckBox Content="{l:Tr struct_create_files}" IsChecked="{Binding CreateFiles}" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:Tr btn_undo}" Command="{Binding UndoCommand}" ToolTip="{Binding UndoDescription}"/>
                <Button Content="{l:Tr struct_create}" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/>
            </StackPanel>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="{l:Tr struct_text_header}" Margin="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="{l:Tr struct_paste}" Command="{Binding PasteCommand}"/>
                        <Button Content="{l:Tr struct_example_btn}" Command="{Binding ExampleCommand}"/>
                        <Button Content="{l:Tr struct_clear}" Command="{Binding ClearCommand}"/>
                    </StackPanel>
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12.5" VerticalContentAlignment="Top"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <GroupBox Grid.Column="2" Header="{l:Tr struct_preview_header}" Margin="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderThickness="0">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding Message}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static st:StructureStatus.Create}">
                                        <Setter Property="Background" Value="{StaticResource ReadyRowBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static st:StructureStatus.Error}">
                                        <Setter Property="Background" Value="{StaticResource ErrorRowBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static st:StructureStatus.Skipped}">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding StatusIcon}" Width="26"/>
                            <DataGridTextColumn Header="{l:Tr col_item}" Binding="{Binding Display}" Width="*"/>
                            <DataGridTextColumn Header="{l:Tr col_notes}" Binding="{Binding Message}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{l:Tr struct_sum_empty}" Style="{StaticResource Hint}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibility}}"/>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
