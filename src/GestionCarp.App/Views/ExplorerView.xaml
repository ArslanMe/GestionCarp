<UserControl x:Class="GestionCarp.App.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GestionCarp.App.ViewModels"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Carpeta -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Carpeta:" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                <Button Content="Examinar…" Command="{Binding BrowseCommand}"/>
                <Button Content="Analizar" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
                <Button Content="Cancelar" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Escribe o pega una ruta, o arrastra una carpeta a la ventana"/>
        </DockPanel>

        <!-- Opciones de análisis -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Profundidad:" Style="{StaticResource FieldLabel}"/>
            <TextBox Width="42" Text="{Binding MaxDepth, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                     ToolTip="Niveles de subcarpetas a analizar. 0 = sin límite"/>
            <TextBlock Text="(0 = todo)" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <CheckBox Content="Mostrar archivos" IsChecked="{Binding IncludeFiles}"
                      ToolTip="Si lo desmarcas, solo se muestran carpetas (los tamaños siguen contando los archivos)"/>
            <CheckBox Content="Incluir ocultos y de sistema" IsChecked="{Binding IncludeHidden}"/>
            <TextBlock Text="Excluir:" Style="{StaticResource FieldLabel}"/>
            <TextBox Width="280" Text="{Binding ExcludePatterns}" Margin="0,0,16,0"
                     ToolTip="Nombres o patrones separados por ; (admite * y ?)"/>
            <TextBlock Text="Solo archivos:" Style="{StaticResource FieldLabel}"/>
            <TextBox Width="150" Text="{Binding FilePatterns}"
                     ToolTip="Ejemplo: *.mkv; *.mp4. Vacío = todos"/>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Árbol -->
            <GroupBox Grid.Column="0" Header="Contenido" Margin="0">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Content="✏️ Renombrar archivos de esta carpeta" Command="{Binding SendToRenamerCommand}" Margin="0,0,6,4"
                                ToolTip="Envía los archivos de la carpeta seleccionada al renombrador"/>
                        <Button Content="💬 Emparejar subtítulos aquí" Command="{Binding SendToSubtitlesCommand}" Margin="0,0,6,4"/>
                        <Button Content="Abrir en el Explorador" Command="{Binding OpenInExplorerCommand}" Margin="0,0,6,4"/>
                    </WrapPanel>
                    <Grid>
                        <TreeView ItemsSource="{Binding RootNodes}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  BorderThickness="0">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Setter Property="Padding" Value="1,2"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Node.FullPath}">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" FontSize="11.5"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <TextBlock Text="Elige una carpeta o arrástrala aquí para ver su contenido."
                                   Style="{StaticResource Hint}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasTree, Converter={StaticResource InverseBoolToVisibility}}"/>
                    </Grid>
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Exportación -->
            <GroupBox Grid.Column="2" Header="Exportar / compartir la estructura" Margin="0">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Formato:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="140" Margin="0,0,14,0"
                                  ItemsSource="{x:Static vm:Choices.ExportFormats}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding ExportFormat}"/>
                        <TextBlock Text="Niveles:" Style="{StaticResource FieldLabel}"/>
                        <TextBox Width="42" Text="{Binding ExportDepth, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0"
                                 ToolTip="Niveles a exportar. 0 = todos"/>
                    </WrapPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <CheckBox Content="Archivos" IsChecked="{Binding ExportIncludeFiles}"/>
                        <CheckBox Content="Tamaños" IsChecked="{Binding ShowSizes}"/>
                        <CheckBox Content="Fechas" IsChecked="{Binding ShowDates}"/>
                        <CheckBox Content="Totales por carpeta" IsChecked="{Binding ShowCounts}"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ExportTitle}" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="📋 Copiar al portapapeles" Command="{Binding CopyCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="💾 Guardar como…" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                    <TextBox Text="{Binding ExportPreview, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12.5"
                             VerticalContentAlignment="Top"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" Background="{StaticResource PanelBrush}"/>
                </DockPanel>
            </GroupBox>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="2,8,0,0" Foreground="{StaticResource MutedBrush}"/>
    </Grid>
</UserControl>
