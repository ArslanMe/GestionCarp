<UserControl x:Class="GestionCarp.App.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GestionCarp.App.Localization"
             xmlns:vm="clr-namespace:GestionCarp.App.ViewModels"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Carpeta -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{l:Tr lbl_folder}" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                <Button Content="{l:Tr btn_browse}" Command="{Binding BrowseCommand}"/>
                <Button Content="{l:Tr btn_scan}" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
                <Button Content="{l:Tr btn_cancel}" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{l:Tr exp_path_tip}"/>
        </DockPanel>

        <!-- Opciones de análisis -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{l:Tr exp_depth}" Style="{StaticResource FieldLabel}"/>
            <TextBox Width="42" Text="{Binding MaxDepth, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                     ToolTip="{l:Tr exp_depth_tip}"/>
            <TextBlock Text="{l:Tr exp_depth_all}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <CheckBox Content="{l:Tr exp_show_files}" IsChecked="{Binding IncludeFiles}"
                      ToolTip="{l:Tr exp_show_files_tip}"/>
            <CheckBox Content="{l:Tr exp_hidden}" IsChecked="{Binding IncludeHidden}"/>
            <TextBlock Text="{l:Tr exp_exclude}" Style="{StaticResource FieldLabel}"/>
            <TextBox Width="280" Text="{Binding ExcludePatterns}" Margin="0,0,16,0"
                     ToolTip="{l:Tr exp_exclude_tip}"/>
            <TextBlock Text="{l:Tr exp_only_files}" Style="{StaticResource FieldLabel}"/>
            <TextBox Width="150" Text="{Binding FilePatterns}"
                     ToolTip="{l:Tr exp_only_files_tip}"/>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Árbol -->
            <GroupBox Grid.Column="0" Header="{l:Tr exp_content}" Margin="0">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Content="{l:Tr exp_send_rename}" Command="{Binding SendToRenamerCommand}" Margin="0,0,6,4"
                                ToolTip="{l:Tr exp_send_rename_tip}"/>
                        <Button Content="{l:Tr exp_send_subs}" Command="{Binding SendToSubtitlesCommand}" Margin="0,0,6,4"/>
                        <Button Content="{l:Tr exp_open_explorer}" Command="{Binding OpenInExplorerCommand}" Margin="0,0,6,4"/>
                    </WrapPanel>
                    <Grid>
                        <TreeView ItemsSource="{Binding RootNodes}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  BorderThickness="0">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Setter Property="Padding" Value="1,2"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Node.FullPath}">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" FontSize="11.5"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <TextBlock Text="{l:Tr exp_empty_hint}"
                                   Style="{StaticResource Hint}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasTree, Converter={StaticResource InverseBoolToVisibility}}"/>
                    </Grid>
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Exportación -->
            <GroupBox Grid.Column="2" Header="{l:Tr exp_export_header}" Margin="0">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="{l:Tr exp_format}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="140" Margin="0,0,14,0"
                                  ItemsSource="{x:Static vm:Choices.ExportFormats}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding ExportFormat}"/>
                        <TextBlock Text="{l:Tr exp_levels}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Width="42" Text="{Binding ExportDepth, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0"
                                 ToolTip="{l:Tr exp_levels_tip}"/>
                    </WrapPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <CheckBox Content="{l:Tr exp_opt_files}" IsChecked="{Binding ExportIncludeFiles}"/>
                        <CheckBox Content="{l:Tr exp_opt_sizes}" IsChecked="{Binding ShowSizes}"/>
                        <CheckBox Content="{l:Tr exp_opt_dates}" IsChecked="{Binding ShowDates}"/>
                        <CheckBox Content="{l:Tr exp_opt_counts}" IsChecked="{Binding ShowCounts}"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ExportTitle}" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{l:Tr exp_copy}" Command="{Binding CopyCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="{l:Tr exp_save}" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                    <TextBox Text="{Binding ExportPreview, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12.5"
                             VerticalContentAlignment="Top"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" Background="{StaticResource PanelBrush}"/>
                </DockPanel>
            </GroupBox>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="2,8,0,0" Foreground="{StaticResource MutedBrush}"/>
    </Grid>
</UserControl>
