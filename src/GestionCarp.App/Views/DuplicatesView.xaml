<UserControl x:Class="GestionCarp.App.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GestionCarp.App.Localization"
             xmlns:vm="clr-namespace:GestionCarp.App.ViewModels"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="{l:Tr dup_intro}" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,0,0,8"/>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" Height="64"/>
                <TextBlock Text="{l:Tr dup_folders_hint}" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Visibility="{Binding HasFolders, Converter={StaticResource InverseBoolToVisibility}}"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <Button Content="{l:Tr dup_add_folder}" Command="{Binding AddFolderCommand}" Margin="0,0,0,4"/>
                <Button Content="{l:Tr ren_remove}" Command="{Binding RemoveFolderCommand}" Margin="0"/>
            </StackPanel>
        </Grid>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{l:Tr dup_min_size}" Style="{StaticResource FieldLabel}"/>
            <TextBox Width="60" Margin="0,0,4,4" Text="{Binding MinSizeKb, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="KB" Style="{StaticResource FieldLabel}" Margin="0,0,14,4"/>
            <TextBlock Text="{l:Tr exp_only_files}" Style="{StaticResource FieldLabel}"/>
            <TextBox Width="130" Margin="0,0,14,4" Text="{Binding FilePatterns}" ToolTip="{l:Tr exp_only_files_tip}"/>
            <TextBlock Text="{l:Tr exp_exclude}" Style="{StaticResource FieldLabel}"/>
            <TextBox Width="200" Margin="0,0,14,4" Text="{Binding ExcludePatterns}" ToolTip="{l:Tr exp_exclude_tip}"/>
            <CheckBox Content="{l:Tr exp_hidden}" IsChecked="{Binding IncludeHidden}" Margin="0,0,14,4"/>
            <Button Content="{l:Tr dup_search}" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,4"/>
            <Button Content="{l:Tr btn_cancel}" Command="{Binding CancelCommand}" Margin="0,0,6,4"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
        </WrapPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="{l:Tr dup_keep}" Style="{StaticResource FieldLabel}" Margin="0,0,6,4"/>
                <ComboBox Width="190" Margin="0,0,6,4" ItemsSource="{x:Static vm:Choices.KeepPolicies}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding Keep}"/>
                <Button Content="{l:Tr dup_automark}" Command="{Binding AutoMarkCommand}" Margin="0,0,6,4"/>
                <Button Content="{l:Tr dup_unmark}" Command="{Binding UnmarkAllCommand}" Margin="0,0,6,4"/>
                <Button Content="{l:Tr dup_recycle}" Command="{Binding RecycleCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,4"/>
            </WrapPanel>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </DockPanel>

        <Grid>
            <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding RowsView}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="None" Background="White"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.IsVirtualizing="True"
                      SelectionMode="Single">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,10,0,3" Foreground="{StaticResource AccentDarkBrush}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding File.Path}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ErrorRowBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="30">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsMarked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"
                                          ToolTip="{l:Tr dup_mark_tip}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:Tr xl_name}" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="{l:Tr col_folder}" Binding="{Binding Folder}" Width="*"/>
                    <DataGridTextColumn Header="{l:Tr xl_modified}" Binding="{Binding Modified}" Width="130"/>
                    <DataGridTemplateColumn Header="" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="📂" Padding="6,0" Margin="2,0" MinWidth="0" ToolTip="{l:Tr exp_open_explorer}"
                                        Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{l:Tr dup_empty_hint}" Style="{StaticResource Hint}" FontSize="13" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibility}}"/>
        </Grid>
    </DockPanel>
</UserControl>
