<Window x:Class="GestionCarp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GestionCarp.App.Views"
        xmlns:l="clr-namespace:GestionCarp.App.Localization"
        Title="{l:Tr app_title}"
        Icon="/Assets/app.ico"
        Height="700" Width="1180" MinHeight="480" MinWidth="820"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Loaded="OnLoaded" Closing="OnClosing">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding HelpCommand}"/>
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="4,2" Background="{StaticResource PanelBrush}">
            <MenuItem Header="{l:Tr menu_file}">
                <MenuItem Header="{l:Tr menu_shell}" IsCheckable="True" IsChecked="{Binding ExplorerMenu}" ToolTip="{l:Tr menu_shell_tip}"/>
                <Separator/>
                <MenuItem Header="{l:Tr menu_exit}" Command="{Binding ExitCommand}" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="{l:Tr menu_language}">
                <MenuItem Header="Español" IsChecked="{Binding IsSpanish, Mode=OneWay}"
                          Command="{Binding SetLanguageCommand}" CommandParameter="es"/>
                <MenuItem Header="English" IsChecked="{Binding IsEnglish, Mode=OneWay}"
                          Command="{Binding SetLanguageCommand}" CommandParameter="en"/>
                <MenuItem Header="Português" IsChecked="{Binding IsPortuguese, Mode=OneWay}"
                          Command="{Binding SetLanguageCommand}" CommandParameter="pt"/>
            </MenuItem>
            <MenuItem Header="{l:Tr menu_help}">
                <MenuItem Header="{l:Tr menu_guide}" Command="{Binding HelpCommand}" InputGestureText="F1"/>
                <Separator/>
                <MenuItem Header="{l:Tr menu_check_updates}" Command="{Binding CheckUpdatesCommand}"/>
                <MenuItem Header="{l:Tr menu_check_startup}" IsCheckable="True" IsChecked="{Binding CheckUpdatesOnStartup}"/>
                <Separator/>
                <MenuItem Header="{l:Tr menu_github}" Command="{Binding OpenGitHubCommand}"/>
                <MenuItem Header="{l:Tr menu_about}" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <TabControl SelectedIndex="{Binding SelectedTab}" Margin="6" Padding="0">
            <TabItem Header="{l:Tr tab_explorer}" Padding="12,4">
                <views:ExplorerView DataContext="{Binding Explorer}"/>
            </TabItem>
            <TabItem Header="{l:Tr tab_rename}" Padding="12,4">
                <views:RenamerView DataContext="{Binding Renamer}"/>
            </TabItem>
            <TabItem Header="{l:Tr tab_subs}" Padding="12,4">
                <views:SubtitlesView DataContext="{Binding Subtitles}"/>
            </TabItem>
            <TabItem Header="{l:Tr tab_struct}" Padding="12,4">
                <views:StructureView DataContext="{Binding Structure}"/>
            </TabItem>
            <TabItem Header="{l:Tr tab_compare}" Padding="12,4">
                <views:CompareView DataContext="{Binding Compare}"/>
            </TabItem>
            <TabItem Header="{l:Tr tab_duplicates}" Padding="12,4">
                <views:DuplicatesView DataContext="{Binding Duplicates}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
