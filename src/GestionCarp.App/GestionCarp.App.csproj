<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Permite compilar también desde Linux/macOS (por ejemplo en CI). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GestionCarp</AssemblyName>
    <RootNamespace>GestionCarp.App</RootNamespace>
    <Product>GestionCarp</Product>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Authors>Raudel Camacho</Authors>
    <Company>Raudel Camacho</Company>
    <Copyright>© 2026 Raudel Camacho</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Explorador de carpetas, exportación de estructuras y renombrado por lotes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestionCarp.Core\GestionCarp.Core.csproj" />
  </ItemGroup>

</Project>
